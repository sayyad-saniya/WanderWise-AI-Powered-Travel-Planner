# Copy this file to .env (or export the same variables in your shell) before running the backend.

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/wanderwise

# OpenAI - used to generate itineraries + budget estimates
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# OpenWeatherMap - used for the destination forecast
OPENWEATHER_API_KEY=your-openweathermap-key-here

# CORS + share-link generation
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

PORT=8080
